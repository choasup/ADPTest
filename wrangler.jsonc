{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "contexta",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIBRARY", "class_name": "ContextaLibrary" }]
  },
  "routes": [
    { "pattern": "contexta.adpworker.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContextaLibrary"] }],
  "observability": { "enabled": true }
}
